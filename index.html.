main{max-width:980px;margin:0 auto;padding:20px 16px 40px}
section{display:none}section.on{display:block}
h2{margin:0 0 4px;color:var(--pr)}h3{margin:14px 0 6px}
.sub{color:var(--mu);margin:0 0 14px}
.grid{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:16px}
.card h3{margin:0 0 6px;font-size:17px}
.card p,.card li{color:var(--mu);font-size:14px;margin:0}
.card ul{margin:0;padding-left:18px}
.tag{display:inline-block;background:var(--ac);color:var(--tx);border-radius:999px;padding:2px 10px;font-size:12px;margin:6px 4px 0 0}
.hl{border-left:4px solid var(--ac2);padding-left:14px;margin:12px 0}
.flow{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:8px;margin:14px 0}
.flow div{background:var(--pd);color:#fff;border-radius:12px;padding:9px 14px;text-align:center;font-size:14px}
.tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
.tabs button{border:1px solid var(--bd);background:var(--card);color:var(--tx);border-radius:10px;padding:8px 12px;cursor:pointer;font-size:14px}
.tabs button.on{background:var(--pr);color:#fff;border-color:var(--pr)}
.step{display:flex;gap:12px;align-items:flex-start;background:var(--card);border:1px solid var(--bd);border-radius:12px;padding:12px;margin-bottom:8px;cursor:pointer}
.step b.n{flex:none;width:30px;height:30px;border-radius:50%;background:var(--pr);color:#fff;display:grid;place-items:center}
.step p{margin:2px 0 0;color:var(--mu);font-size:14px}
.opt{display:block;width:100%;text-align:left;background:var(--card);color:var(--tx);border:1px solid var(--bd);border-radius:10px;padding:10px 14px;margin:6px 0;font-size:15px;cursor:pointer}
.opt.ok{background:var(--ok);color:#fff;border-color:var(--ok)}
.opt.no{background:var(--no);color:#fff;border-color:var(--no)}
.fb{margin:8px 0;color:var(--mu);font-size:14px}
.prog{height:6px;background:var(--bd);border-radius:9px;margin-bottom:14px}.prog i{display:block;height:100%;background:var(--pr);border-radius:9px;transition:width .3s}
input,textarea{width:100%;padding:9px 10px;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx);font:inherit}
label{font-size:13px;color:var(--mu);display:block;margin-top:8px}
.res{display:grid;gap:10px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));margin-top:12px}
.res div{background:var(--ac);color:var(--tx);border-radius:12px;padding:12px;font-size:14px}
.res b{display:block;font-size:20px}
.nx{display:flex;justify-content:space-between;margin-top:24px}
