#cover{min-height:100vh;min-height:100dvh;display:flex;align-items:center;justify-content:center;text-align:center;padding:32px 20px;color:#fff;background:radial-gradient(circle at 15% 20%,rgba(255,255,255,.12) 0 90px,transparent 91px),radial-gradient(circle at 88% 78%,rgba(243,217,160,.18) 0 140px,transparent 141px),linear-gradient(150deg,#0b3b3d,#0f6e6a)}
#cover .in{max-width:640px}
#cover .ic{font-size:64px;line-height:1}
#cover .lb{display:inline-block;letter-spacing:.18em;font-size:12px;border:1px solid rgba(255,255,255,.45);border-radius:999px;padding:4px 14px;margin:14px 0}
#cover h1{margin:6px 0 10px;font-size:clamp(28px,7vw,48px);line-height:1.15}
#cover p{margin:0 auto 18px;opacity:.9;max-width:520px}
#cover .ch{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:26px}
#cover .ch span{background:rgba(255,255,255,.14);border-radius:10px;padding:6px 14px;font-size:14px}
#cover .btn{font-size:17px;padding:13px 34px}
</style>
