html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.6 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
header{background:linear-gradient(135deg,#0b3b3d,#0f6e6a);color:#fff;padding:32px 20px 24px;text-align:center}
header small{letter-spacing:.15em;font-size:12px;opacity:.85}
header h1{margin:8px 0;font-size:clamp(24px,5vw,36px);line-height:1.2}
header p{margin:0 auto 16px;max-width:600px;opacity:.9}
.btn{background:var(--ac2);color:#fff;border:0;border-radius:999px;padding:10px 24px;font-size:15px;font-weight:600;cursor:pointer}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--card);border-bottom:1px solid var(--bd);display:flex;gap:6px;overflow-x:auto;padding:8px 12px}
