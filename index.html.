const q=Q[qi];ans=false;z.innerHTML=`<div class="card"><p>${nm} · Soal ${qi+1} dari ${Q.length} · Skor sementara: ${sc}</p><h3>${q[0]}</h3>${q[1].map((o,i)=>`<button class="opt" data-i="${i}">${o}</button>`).join("")}<div class="fb" id="fb"></div></div>`;
z.querySelectorAll(".opt").forEach(b=>b.onclick=()=>{if(ans)return;ans=true;const i=+b.dataset.i;z.querySelectorAll(".opt")[q[2]].classList.add("ok");if(i===q[2])sc++;else b.classList.add("no");
$("fb").innerHTML=(i===q[2]?"✅ Benar! ":"❌ Kurang tepat. ")+q[3]+`<br><br><button class="btn" style="background:var(--pr)" onclick="qi++;rq()">${qi===Q.length-1?"Lihat skor":"Lanjut"}</button>`})}
